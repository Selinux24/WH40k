{
	"mcpServers": {
		"io.github.wonderwhy-er/desktop-commander": {
			"type": "local",
			"command": "npx",
			"args": [
				"--registry",
				"https://registry.npmjs.org",
				"@wonderwhy-er/desktop-commander@0.3.0"
			],
			"tools": [
				"*"
			]
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp",
			"tools": [
				"*"
			]
		},
		"playwright": {
			"type": "local",
			"command": "npx",
			"args": [
				"-y",
				"@microsoft/mcp-server-playwright"
			],
			"tools": [
				"*"
			]
		}
	}
}
